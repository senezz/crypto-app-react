rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A user's own portfolio doc (assets array, telegramLink) and
    // its transaction history - both readable/writable only by that
    // same authenticated user (portfolioId/userId is always the
    // Firebase Auth uid throughout the client code).
    match /portfolios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Telegram-link verification codes are written by the bot backend
    // (Admin SDK, bypasses these rules) and looked up by any signed-in
    // client via a value query, not by uid-scoped document id.
    match /tg-codes/{codeId} {
      allow read: if request.auth != null;
    }
  }
}
